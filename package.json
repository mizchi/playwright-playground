{
  "name": "playwright-playground",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "app:build": "vite build",
    "app:preview": "vite preview --port 4173 --strictPort",
    "test": "playwright test",
    "verify": "playwright test && playwright test",
    "baseline": "playwright test --update-snapshots",
    "baseline:linux": "docker run --rm --network host -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.61.1-noble sh -c \"corepack enable && pnpm install --frozen-lockfile=false && pnpm exec playwright test --update-snapshots\""
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@secretlint/secretlint-rule-preset-recommend": "^9.0.0",
    "secretlint": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
